import { Component, EventEmitter, OnInit, Output } from '@angular/core';
import { CommonModule } from '@angular/common';
import { MatTreeModule, MatTreeNestedDataSource } from '@angular/material/tree';
import { MatIconModule } from '@angular/material/icon';
import { MatButtonModule } from '@angular/material/button';
import { NestedTreeControl } from '@angular/cdk/tree';
import { HierarchyService } from '../../core/hierarchy.service';
import { NodeDto } from '../../core/models/node.model';

/**
 * Selecteur de noeud partage. L'arbre affiche uniquement le sous-arbre renvoye par le
 * backend. Un noeud a plusieurs parents apparait sous chacun d'eux, avec un marqueur.
 */
@Component({
  selector: 'app-node-picker',
  standalone: true,
  imports: [CommonModule, MatTreeModule, MatIconModule, MatButtonModule],
  template: `
    <div class="picker">
      <p *ngIf="loading">Loading hierarchy...</p>
      <p *ngIf="error" class="error">{{ error }}</p>

      <mat-tree [dataSource]="dataSource" [treeControl]="treeControl">

        <mat-tree-node *matTreeNodeDef="let node" matTreeNodeToggle>
          <button mat-icon-button disabled></button>
          <span class="label" [class.selected]="node.id === selected?.id"
                (click)="select(node)">
            {{ node.label }} <small>({{ node.id }})</small>
            <span *ngIf="node.duplicated" class="dup" title="Plusieurs parents">&#9888;</span>
          </span>
        </mat-tree-node>

        <mat-nested-tree-node *matTreeNodeDef="let node; when: hasChild">
          <div class="row">
            <button mat-icon-button matTreeNodeToggle>
              <mat-icon>
                {{ treeControl.isExpanded(node) ? 'expand_more' : 'chevron_right' }}
              </mat-icon>
            </button>
            <span class="label" [class.selected]="node.id === selected?.id"
                  (click)="select(node)">
              {{ node.label }} <small>({{ node.id }})</small>
              <span *ngIf="node.duplicated" class="dup" title="Plusieurs parents">&#9888;</span>
            </span>
          </div>
          <div [class.hidden]="!treeControl.isExpanded(node)" class="nested">
            <ng-container matTreeNodeOutlet></ng-container>
          </div>
        </mat-nested-tree-node>

      </mat-tree>
    </div>
  `,
  styles: [`
    .picker { max-height: 320px; overflow: auto; border: 1px solid #ddd; padding: 8px; }
    .row { display: flex; align-items: center; }
    .label { cursor: pointer; padding: 2px 4px; }
    .label.selected { background: #2b3a67; color: #fff; }
    .nested { padding-left: 24px; }
    .hidden { display: none; }
    .dup { color: #b8860b; margin-left: 4px; }
    .error { color: #b00020; }
  `]
})
export class NodePickerComponent implements OnInit {

  @Output() nodeSelected = new EventEmitter<NodeDto>();

  treeControl = new NestedTreeControl<NodeDto>(node => node.children);
  dataSource = new MatTreeNestedDataSource<NodeDto>();
  selected: NodeDto | null = null;
  loading = false;
  error = '';

  constructor(private hierarchy: HierarchyService) {}

  async ngOnInit(): Promise<void> {
    this.loading = true;
    try {
      this.dataSource.data = await this.hierarchy.getSubtree();
    } catch (e: any) {
      this.error = e.message;
    } finally {
      this.loading = false;
    }
  }

  hasChild = (_: number, node: NodeDto) => !!node.children && node.children.length > 0;

  select(node: NodeDto): void {
    this.selected = node;
    this.nodeSelected.emit(node);
  }
}
