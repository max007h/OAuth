### `frontend/src/app/features/create-user/create-user.component.ts`

```typescript
import { Component } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { NodePickerComponent } from '../node-picker/node-picker.component';
import { ApplicationService } from '../../core/application.service';
import { RoleService } from '../../core/role.service';
import { ProvisioningService } from '../../core/provisioning.service';
import { NodeDto } from '../../core/models/node.model';
import { ApplicationDto, RoleDto } from '../../core/models/assignment.model';

/** Une ligne d'affectation en cours de saisie. */
interface AssignmentRow {
  node: NodeDto | null;
  applications: ApplicationDto[];
  application: string;
  roles: RoleDto[];
  role: string;
}

/**
 * Remplace l'ancien formulaire a champ "role" unique.
 * Ordre impose par le metier : noeud d'abord, puis application, puis role. Les roles
 * sont specialises par organisation, donc ils ne peuvent pas etre charges avant.
 */
@Component({
  selector: 'app-create-user',
  standalone: true,
  imports: [CommonModule, FormsModule, NodePickerComponent],
  template: `
    <div class="page">
      <h2>Create User</h2>
      <p>Provision a partner user and grant assignments in PingDirectory.</p>

      <h3>Identity</h3>
      <input placeholder="Login (uid)" [(ngModel)]="identity.uid" name="uid">
      <input placeholder="First Name" [(ngModel)]="identity.firstName" name="firstName">
      <input placeholder="Last Name" [(ngModel)]="identity.lastName" name="lastName">
      <input placeholder="Email" [(ngModel)]="identity.email" name="email">

      <h3>Assignments</h3>
      <div class="assignment" *ngFor="let row of rows; let i = index">
        <app-node-picker (nodeSelected)="onNodeSelected(row, $event)"></app-node-picker>

        <div class="line">
          <span class="chosen">{{ row.node ? row.node.label : 'Select a node' }}</span>

          <select [(ngModel)]="row.application" name="app{{i}}"
                  (change)="onApplicationChange(row)" [disabled]="!row.node">
            <option value="">Application</option>
            <option *ngFor="let a of row.applications" [value]="a.id">{{ a.name }}</option>
          </select>

          <select [(ngModel)]="row.role" name="role{{i}}" [disabled]="!row.application">
            <option value="">Role</option>
            <option *ngFor="let r of row.roles" [value]="r.id">{{ r.name }}</option>
          </select>

          <button (click)="removeRow(i)" [disabled]="rows.length === 1">Remove</button>
        </div>
      </div>
      <button (click)="addRow()">Add assignment</button>

      <h3>Scopes</h3>
      <label>Operational (opScope)</label>
      <input placeholder="2700010, 2700011" [(ngModel)]="opScopeRaw" name="opScope">
      <label>Excluded (opScopeExclude)</label>
      <input placeholder="2700012" [(ngModel)]="opScopeExcludeRaw" name="opScopeExclude">
      <label>Reporting (reportScope)</label>
      <input placeholder="9200005" [(ngModel)]="reportScopeRaw" name="reportScope">

      <button class="primary" (click)="submit()" [disabled]="loading">Create User</button>

      <p class="ok" *ngIf="successMessage">{{ successMessage }}</p>
      <p class="ko" *ngIf="errorMessage">{{ errorMessage }}</p>
    </div>
  `,
  styles: [`
    .page { max-width: 760px; margin: 24px auto; }
    input, select { display: block; margin: 6px 0; padding: 8px; width: 100%; }
    .assignment { border: 1px solid #eee; padding: 12px; margin-bottom: 12px; }
    .line { display: flex; gap: 8px; align-items: center; margin-top: 8px; }
    .line select { width: auto; flex: 1; }
    .chosen { min-width: 160px; font-weight: 600; }
    .primary { margin-top: 16px; padding: 12px; width: 100%;
               background: #2b3a67; color: #fff; border: 0; }
    .ok { color: #1b5e20; }
    .ko { color: #b00020; }
  `]
})
export class CreateUserComponent {

  identity = { uid: '', firstName: '', lastName: '', email: '' };
  rows: AssignmentRow[] = [this.emptyRow()];

  opScopeRaw = '';
  opScopeExcludeRaw = '';
  reportScopeRaw = '';

  loading = false;
  successMessage = '';
  errorMessage = '';

  constructor(private applications: ApplicationService,
              private roles: RoleService,
              private provisioning: ProvisioningService) {}

  emptyRow(): AssignmentRow {
    return { node: null, applications: [], application: '', roles: [], role: '' };
  }

  addRow(): void {
    this.rows.push(this.emptyRow());
  }

  removeRow(index: number): void {
    this.rows.splice(index, 1);
  }

  async onNodeSelected(row: AssignmentRow, node: NodeDto): Promise<void> {
    row.node = node;
    row.application = '';
    row.role = '';
    row.roles = [];
    row.applications = await this.applications.listByNode(node.id);
  }

  async onApplicationChange(row: AssignmentRow): Promise<void> {
    row.role = '';
    row.roles = row.node && row.application
      ? await this.roles.list(row.application, row.node.id)
      : [];
  }

  private split(raw: string): string[] {
    return raw.split(',').map(v => v.trim()).filter(v => v.length > 0);
  }

  async submit(): Promise<void> {
    this.loading = true;
    this.successMessage = '';
    this.errorMessage = '';

    const assignments = this.rows
      .filter(r => r.node && r.application && r.role)
      .map(r => ({ application: r.application, node: r.node!.id, role: r.role }));

    if (assignments.length === 0) {
      this.errorMessage = 'At least one complete assignment is required.';
      this.loading = false;
      return;
    }

    try {
      this.successMessage = await this.provisioning.createUser({
        ...this.identity,
        assignments,
        scopes: {
          opScope: this.split(this.opScopeRaw),
          opScopeExclude: this.split(this.opScopeExcludeRaw),
          reportScope: this.split(this.reportScopeRaw)
        }
      });
    } catch (e: any) {
      this.errorMessage = e.message;
    } finally {
      this.loading = false;
    }
  }
}
```

