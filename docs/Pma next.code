package com.poc.banking.dto;

import java.util.List;

/**
 * Remplace la version a champ "role" unique.
 *
 * portalRole reprend l'ancien "role" COMMERCIAL / MANAGER : il ne disparait pas, il
 * alimente l'appartenance au groupe LDAP, donc isMemberOf, donc le controle COARSE
 * d'acces au portail.
 *
 * assignments et scopes portent le FINE-GRAINED : ce que l'utilisateur peut faire, et
 * sur quels noeuds. Les deux dimensions coexistent : supprimer portalRole creerait des
 * utilisateurs sans aucun acces.
 */
public record CreateUserRequest(
        String uid,
        String firstName,
        String lastName,
        String email,
        String portalRole,
        List<AssignmentDto> assignments,
        ScopesDto scopes
) {
    /** Un utilisateur partenaire n'administre pas le portail par defaut. */
    public String portalRoleOrDefault() {
        return (portalRole == null || portalRole.isBlank()) ? "COMMERCIAL" : portalRole;
    }
}
