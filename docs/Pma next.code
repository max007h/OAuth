
package com.poc.banking.service;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

import javax.naming.Context;
import javax.naming.NamingEnumeration;
import javax.naming.NamingException;
import javax.naming.directory.Attribute;
import javax.naming.directory.Attributes;
import javax.naming.directory.DirContext;
import javax.naming.directory.InitialDirContext;
import java.util.ArrayList;
import java.util.Hashtable;
import java.util.List;

/**
 * LECTURE SEULE des attributs d'autorisation dans PingDirectory.
 *
 * Decoupe volontaire :
 *   - GrantDirectoryClient   : lecture, chemin d'AUTORISATION (DelegationService)
 *   - UserProvisioningService: ecriture, chemin de PROVISIONING
 *
 * C'est la meme decoupe que les deux comptes de service de 04-comptes-service.ldif :
 * cn=paz-service en lecture seule, cn=puma-service en ecriture. Le jour ou tu passes
 * a ces comptes, cette classe est la seule a changer de credentials.
 *
 * Aucune methode d'ecriture ici. En ajouter une recreerait le doublon de connexion LDAP
 * qui a masque le probleme de bind DN.
 */
@Component
public class GrantDirectoryClient {

    public static final String ATTR_GRANT       = "partnerGrant";
    public static final String ATTR_OP_SCOPE    = "opScope";
    public static final String ATTR_OP_EXCLUDE  = "opScopeExclude";
    public static final String ATTR_REPORT      = "reportScope";
    public static final String ATTR_IS_MEMBER_OF = "isMemberOf";

    @Value("${pingdirectory.host}")
    private String host;

    @Value("${pingdirectory.ldap-port}")
    private int ldapPort;

    @Value("${pingdirectory.base-dn}")
    private String baseDn;

    /**
     * ATTENTION : "cn=administrator" NU, sans dc=example,dc=com.
     * Le root DN de PingDirectory vit dans cn=Root DNs,cn=config, pas sous le suffixe.
     * Avec le DN complet, le bind rend LDAP error 49, invalid credentials, et le
     * symptome visible est un sous-arbre vide dans l'ecran de creation, sans message.
     */
    @Value("${pingdirectory.admin-dn}")
    private String adminDn;

    @Value("${pingdirectory.admin-password}")
    private String adminPwd;

    // =========================================================================
    //  Lectures
    // =========================================================================

    /** Valeurs d'un attribut multivalue. Entree ou attribut absent : liste vide. */
    public List<String> readValues(String uid, String attribute) {
        List<String> values = new ArrayList<>();
        DirContext ctx = null;
        try {
            ctx = connect();
            Attributes attrs = ctx.getAttributes(userDn(uid), new String[]{attribute});
            Attribute attr = attrs.get(attribute);
            if (attr != null) {
                NamingEnumeration<?> all = attr.getAll();
                while (all.hasMore()) {
                    values.add(String.valueOf(all.next()));
                }
            }
        } catch (NamingException e) {
            // Volontairement silencieux : un utilisateur sans grant n'est pas une erreur.
        } finally {
            closeQuietly(ctx);
        }
        return values;
    }

    /**
     * Les noeuds sur lesquels ce sujet detient un grant, extraits de "application|noeud|role".
     * C'est le point d'entree de tout le controle de delegation : ces noeuds bornent le
     * sous-arbre que le manager peut voir et sur lequel il peut affecter.
     */
    public List<String> readGrantedNodes(String uid) {
        List<String> nodes = new ArrayList<>();
        for (String grant : readValues(uid, ATTR_GRANT)) {
            String[] parts = grant.split("\\|");
            if (parts.length == 3) {
                nodes.add(parts[1]);
            }
        }
        return nodes;
    }

    /** Grants bruts, format IDM. Utile pour le diagnostic et pour l'API runtime. */
    public List<String> readGrants(String uid) {
        return readValues(uid, ATTR_GRANT);
    }

    public boolean exists(String uid) {
        DirContext ctx = null;
        try {
            ctx = connect();
            ctx.getAttributes(userDn(uid), new String[]{"uid"});
            return true;
        } catch (NamingException e) {
            return false;
        } finally {
            closeQuietly(ctx);
        }
    }

    /** isMemberOf est l'equivalent PingDirectory de memberOf, calcule par le serveur. */
    public boolean isMemberOfGroup(String uid, String group) {
        return readValues(uid, ATTR_IS_MEMBER_OF).stream()
                .anyMatch(dn -> dn.startsWith("cn=" + group + ","));
    }

    // =========================================================================
    //  Helpers
    // =========================================================================

    private String userDn(String uid) {
        return "uid=" + uid + "," + baseDn;
    }

    private DirContext connect() throws NamingException {
        Hashtable<String, String> env = new Hashtable<>();
        env.put(Context.INITIAL_CONTEXT_FACTORY, "com.sun.jndi.ldap.LdapCtxFactory");
        env.put(Context.PROVIDER_URL, "ldap://" + host + ":" + ldapPort);
        env.put(Context.SECURITY_AUTHENTICATION, "simple");
        env.put(Context.SECURITY_PRINCIPAL, adminDn);
        env.put(Context.SECURITY_CREDENTIALS, adminPwd);
        return new InitialDirContext(env);
    }

    private void closeQuietly(DirContext ctx) {
        if (ctx != null) {
            try {
                ctx.close();
            } catch (NamingException ignored) {
                // rien a faire
            }
        }
    }
}

















package com.poc.banking.controller;

import com.poc.banking.dto.CreateUserRequest;
import com.poc.banking.service.UserProvisioningService;
import com.poc.banking.service.UserProvisioningService.ProvisioningResult;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.security.oauth2.server.resource.authentication.JwtAuthenticationToken;
import org.springframework.web.bind.annotation.*;

import java.util.LinkedHashMap;
import java.util.Map;

@RestController
@RequestMapping("/api/users")
public class UserController {

    @Autowired
    private UserProvisioningService userService;

    @PostMapping
    public ResponseEntity<?> createUser(@RequestBody CreateUserRequest req,
                                        JwtAuthenticationToken token) {

        // COARSE : acces au portail PUMA, lu dans isMemberOf.
        if (!JwtSubject.isManager(token)) {
            return ResponseEntity.status(403).body("Acces refuse : role MANAGER requis");
        }

        try {
            // sub : identifie le manager, cle de lecture de ses propres grants.
            String managerUid = JwtSubject.uid(token);
            // Le token brut est relaye au PDP pour qu'il resolve TokenOwner lui-meme.
            String bearerToken = token.getToken().getTokenValue();

            ProvisioningResult result =
                    userService.createOrUpdate(req, managerUid, bearerToken);

            Map<String, Object> body = new LinkedHashMap<>();
            body.put("message", result.created()
                    ? "Utilisateur " + req.uid() + " cree avec succes."
                    : "Utilisateur " + req.uid()
                      + " existant : nouvelles affectations ajoutees.");

            if (result.resetUrl() != null) {
                body.put("passwordResetUrl", result.resetUrl());
                body.put("instruction",
                        "L'utilisateur doit initialiser son mot de passe en cliquant sur "
                        + "le lien recu par mail.");
            } else {
                // L'entree et les grants sont ecrits : ce n'est pas un echec de creation.
                body.put("warning",
                        "Utilisateur provisionne, mais le lien d'initialisation n'a pas "
                        + "pu etre genere. A renvoyer manuellement.");
            }
            return ResponseEntity.ok(body);

        } catch (SecurityException e) {
            // Refus de delegation, rendu par le PDP ou en local selon puma.authz.mode.
            return ResponseEntity.status(403).body(e.getMessage());

        } catch (IllegalArgumentException e) {
            return ResponseEntity.badRequest().body(e.getMessage());

        } catch (IllegalStateException e) {
            // PDP injoignable : deny-unless-permit, jamais d'ouverture par defaut.
            return ResponseEntity.status(503).body(e.getMessage());

        } catch (Exception e) {
            // NamingException et consorts : echec d'ecriture LDAP.
            return ResponseEntity.status(500)
                    .body("Provisioning en echec : " + e.getMessage());
        }
    }
}
