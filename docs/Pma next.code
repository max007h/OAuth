package com.poc.banking.config;

import jakarta.annotation.PostConstruct;
import org.springframework.core.io.ClassPathResource;
import org.springframework.core.io.Resource;
import org.springframework.jdbc.datasource.init.ScriptUtils;
import org.springframework.stereotype.Component;

import javax.sql.DataSource;
import java.sql.Connection;

/**
 * Execution EXPLICITE de schema.sql puis data.sql au demarrage.
 *
 * Pourquoi ne pas utiliser spring.sql.init : sur cette configuration, ni
 * spring.sql.init.mode ni spring.jpa.hibernate.ddl-auto ne produisaient le moindre
 * log au demarrage. Plutot que de chercher pourquoi, on execute les scripts nous-memes.
 * Le comportement devient visible et deterministe : chaque etape se journalise.
 *
 * A utiliser avec :
 *     spring.jpa.hibernate.ddl-auto: none
 *     spring.sql.init.mode: never        (ou la ligne supprimee)
 *
 * Les deux scripts sont idempotents (CREATE TABLE IF NOT EXISTS, ON CONFLICT DO
 * NOTHING), donc ils peuvent rejouer a chaque demarrage sans effet de bord.
 */
@Component
public class DatabaseBootstrap {

    private final DataSource dataSource;

    public DatabaseBootstrap(DataSource dataSource) {
        this.dataSource = dataSource;
    }

    @PostConstruct
    public void run() {
        System.out.println("[DatabaseBootstrap] Initialisation de la base...");
        execute("schema.sql");
        execute("data.sql");
        System.out.println("[DatabaseBootstrap] Termine.");
    }

    private void execute(String fileName) {
        Resource script = new ClassPathResource(fileName);

        if (!script.exists()) {
            // Message explicite : c'est la panne la plus frequente. Le fichier doit
            // etre dans src/main/resources, donc dans target/classes apres build.
            System.out.println("[DatabaseBootstrap] " + fileName
                    + " INTROUVABLE dans le classpath. Verifier src/main/resources.");
            return;
        }

        try (Connection connection = dataSource.getConnection()) {
            ScriptUtils.executeSqlScript(connection, script);
            System.out.println("[DatabaseBootstrap] " + fileName + " execute.");
        } catch (Exception e) {
            // On journalise sans faire echouer le demarrage : sur une base deja
            // initialisee, certaines instructions peuvent legitimement echouer.
            System.out.println("[DatabaseBootstrap] " + fileName + " en echec : "
                    + e.getMessage());
        }
    }
}








package com.poc.banking.service;

import com.fasterxml.jackson.databind.JsonNode;
import jakarta.annotation.PostConstruct;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.http.*;
import org.springframework.http.client.SimpleClientHttpRequestFactory;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import javax.net.ssl.*;
import java.net.HttpURLConnection;
import java.security.SecureRandom;
import java.security.cert.X509Certificate;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

/**
 * Decision fine-grained externalisee vers PingAuthorize.
 *
 * PUMA est le PEP. Il appelle POST /governance-engine/batch avec, pour chaque noeud
 * cible, le contexte de la RESSOURCE : l'identifiant du noeud et ses ancetres calcules
 * par le service hierarchie.
 *
 * Ce que PUMA n'envoie PAS : les grants du manager. Le PDP va les chercher lui-meme dans
 * PingDirectory via TokenOwner, resolu depuis le token relaye. Un demandeur qui declare
 * ses propres droits s'auto-autorise.
 *
 * La regle cote policy tient en une intersection :
 *     PERMIT si  intersection(TokenOwner.partnerGrant.nodes, Resource.parents)  non vide
 *                ET Resource.node not in TokenOwner.partnerGrant.nodes   (strictement sous)
 *
 * Le PDP n'appelle jamais l'API metier de PUMA : seulement un service de donnees de
 * reference. Sinon on cree une boucle PEP -> PDP -> PEP.
 *
 * IMPLEMENTATION : RestTemplate et non RestClient.Builder. Ce dernier n'est expose
 * comme bean qu'a partir de Spring Boot 3.2 et provoque
 * "required a bean of type RestClient$Builder that could not be found" sur les versions
 * anterieures. RestTemplate fonctionne quelle que soit la version.
 */
@Service
@ConditionalOnProperty(name = "puma.authz.mode", havingValue = "pdp")
public class PingAuthorizeDecisionService implements AuthorizationDecisionService {

    private final HierarchyService hierarchy;
    private RestTemplate rest;

    @Value("${puma.authz.pdp.base-url}")
    private String baseUrl;

    @Value("${puma.authz.pdp.domain}")
    private String domain;

    @Value("${puma.authz.pdp.service}")
    private String service;

    @Value("${puma.authz.pdp.action}")
    private String action;

    /** Timeouts explicites : un PDP lent ne doit pas bloquer un thread indefiniment. */
    @Value("${puma.authz.pdp.connect-timeout-ms:2000}")
    private int connectTimeoutMs;

    @Value("${puma.authz.pdp.read-timeout-ms:3000}")
    private int readTimeoutMs;

    public PingAuthorizeDecisionService(HierarchyService hierarchy) {
        this.hierarchy = hierarchy;
    }

    /**
     * Construction apres injection des @Value : le RestTemplate a besoin des timeouts.
     *
     * Le certificat de PingAuthorize sur 7443 est auto-signe : sans trust-all, l'appel
     * rend SSLHandshakeException, unable to find valid certification path.
     * A remplacer par un vrai truststore avant toute mise en production.
     */
    @PostConstruct
    void init() {
        this.rest = new RestTemplate(trustAllRequestFactory());
    }

    // =========================================================================
    //  Decision
    // =========================================================================

    @Override
    public Map<String, Boolean> canAssign(String managerUid, List<String> nodeIds,
                                          String bearerToken) {

        Map<String, Boolean> decisions = new LinkedHashMap<>();
        if (nodeIds == null || nodeIds.isEmpty()) {
            return decisions;
        }

        List<Map<String, Object>> requests = new ArrayList<>();
        for (String nodeId : nodeIds) {
            Map<String, Object> attributes = new LinkedHashMap<>();
            attributes.put("managerUid", managerUid);
            attributes.put("targetNode", nodeId);
            // Contexte de la ressource fourni par le PEP : ce n'est pas un droit declare
            // mais un fait sur la cible, donc acceptable dans la requete.
            attributes.put("targetNodeParents", new ArrayList<>(hierarchy.getParents(nodeId)));

            Map<String, Object> request = new LinkedHashMap<>();
            request.put("domain", domain);
            request.put("service", service);
            request.put("action", action);
            request.put("attributes", attributes);
            requests.add(request);
        }

        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.APPLICATION_JSON);
        headers.setAccept(List.of(MediaType.APPLICATION_JSON));
        // Le token du manager alimente TokenOwner cote PDP, donc la lecture de ses grants.
        headers.set(HttpHeaders.AUTHORIZATION, "Bearer " + bearerToken);

        HttpEntity<Map<String, Object>> entity =
                new HttpEntity<>(Map.of("requests", requests), headers);

        try {
            ResponseEntity<JsonNode> response = rest.exchange(
                    baseUrl + "/governance-engine/batch",
                    HttpMethod.POST,
                    entity,
                    JsonNode.class);

            JsonNode body = response.getBody();
            JsonNode responses = (body != null) ? body.path("responses") : null;

            if (responses == null || !responses.isArray()
                    || responses.size() != nodeIds.size()) {
                throw new IllegalStateException(
                        "Reponse PDP inattendue : " + nodeIds.size()
                        + " requetes envoyees, reponses recues "
                        + (responses == null ? "aucune" : responses.size()));
            }

            // L'ordre des reponses suit l'ordre des requetes.
            for (int i = 0; i < nodeIds.size(); i++) {
                JsonNode decision = responses.get(i);
                boolean permit = "PERMIT".equalsIgnoreCase(
                                        decision.path("decision").asText())
                        || decision.path("authorized").asBoolean(false);
                decisions.put(nodeIds.get(i), permit);
            }
            return decisions;

        } catch (IllegalStateException e) {
            throw e;
        } catch (Exception e) {
            // Deny-unless-permit : un PDP injoignable ne doit jamais ouvrir l'acces.
            // On leve plutot que de rendre des false, pour que le controleur distingue
            // un refus metier (403) d'une indisponibilite (503).
            throw new IllegalStateException(
                    "Decision PDP indisponible, acces refuse par defaut : "
                    + e.getMessage(), e);
        }
    }

    // =========================================================================
    //  TLS
    // =========================================================================

    /**
     * SimpleClientHttpRequestFactory et non HttpComponents : aucune dependance a ajouter
     * au pom. On surcharge prepareConnection pour poser le SSLSocketFactory permissif
     * sur la connexion HTTPS.
     */
    private SimpleClientHttpRequestFactory trustAllRequestFactory() {
        SimpleClientHttpRequestFactory factory = new SimpleClientHttpRequestFactory() {
            @Override
            protected void prepareConnection(HttpURLConnection connection, String httpMethod)
                    throws java.io.IOException {
                if (connection instanceof HttpsURLConnection https) {
                    try {
                        https.setSSLSocketFactory(trustAllSslContext().getSocketFactory());
                        https.setHostnameVerifier((hostname, session) -> true);
                    } catch (Exception e) {
                        throw new java.io.IOException(
                                "Initialisation TLS impossible pour le PDP", e);
                    }
                }
                super.prepareConnection(connection, httpMethod);
            }
        };
        factory.setConnectTimeout(connectTimeoutMs);
        factory.setReadTimeout(readTimeoutMs);
        return factory;
    }

    /** Meme helper que celui de l'ancien UserProvisioningService, pour le PDP. */
    private SSLContext trustAllSslContext() throws Exception {
        TrustManager[] tm = new TrustManager[]{
                new X509TrustManager() {
                    public X509Certificate[] getAcceptedIssuers() {
                        return new X509Certificate[0];
                    }
                    public void checkClientTrusted(X509Certificate[] c, String a) { }
                    public void checkServerTrusted(X509Certificate[] c, String a) { }
                }
        };
        SSLContext sc = SSLContext.getInstance("TLS");
        sc.init(null, tm, new SecureRandom());
        return sc;
    }
}
