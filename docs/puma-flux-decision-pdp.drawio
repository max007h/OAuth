          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="requete LDAP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="grants" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;fontSize=11;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="n6" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="n7" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="SQL recursif" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n4" target="n9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1190" y="435" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="ancetres" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;fontSize=11;" edge="1" parent="1" source="n9" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="noeuds du manager" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n8" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="n10" target="n11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="PERMIT ou DENY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;fontSize=11;" edge="1" parent="1" source="n11" target="n12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;" edge="1" parent="1" source="n12" target="n13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="cible" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1170" width="1260" height="190" as="geometry" />
        </mxCell>
        <mxCell id="cibletitle" value="Cible, non implemente a ce stade - l'axe role" style="text;html=1;fontSize=15;fontStyle=1;align=left;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="1180" width="600" height="25" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="&lt;b&gt;A. Ce que porte le token&lt;/b&gt;&lt;br&gt;role generique, par exemple SALESMAN&lt;br&gt;contexte choisi apres authentification&lt;br&gt;l'application est connue par la session&lt;br&gt;&lt;i&gt;declaratif, donc a revalider&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1215" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;B. Role effectif du manager&lt;/b&gt;&lt;br&gt;segment role du grant retenu&lt;br&gt;a l'etape 7, par exemple ShopAdmin&lt;br&gt;&lt;i&gt;source de verite, pas le token&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="1215" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;C. Entitlement de l'operation&lt;/b&gt;&lt;br&gt;role_permission du role global&lt;br&gt;l'action assign est-elle accordee ?&lt;br&gt;&lt;i&gt;app_role, node_id NULL&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="1215" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;D. Retrait par specialisation&lt;/b&gt;&lt;br&gt;role specialise sur le contexte&lt;br&gt;node_id renseigne, granted = false&lt;br&gt;&lt;i&gt;on ne retire jamais plus qu'on ajoute&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="1215" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;E. Decision&lt;/b&gt;&lt;br&gt;PERMIT si l'entitlement&lt;br&gt;subsiste apres retrait" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1215" width="140" height="90" as="geometry" />
        </mxCell>

        <mxCell id="er1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1;" edge="1" parent="1" source="r1" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1;" edge="1" parent="1" source="r2" target="r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1;" edge="1" parent="1" source="r3" target="r4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1;" edge="1" parent="1" source="r4" target="r5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ciblenote" value="Rappel : le role attribue a l'utilisateur cible n'est encore compare a rien. Un ShopAdmin peut aujourd'hui attribuer n'importe quel role. Regle metier non tranchee." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1315" width="1220" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legende" value="&lt;b&gt;Trous connus&lt;/b&gt;&lt;br&gt;opScope, opScopeExclude et reportScope non branches&lt;br&gt;exclusion du noeud propre non traitee&lt;br&gt;/governance-engine ignore l'en-tete Authorization&lt;br&gt;le sujet est celui declare par le PEP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="130" width="220" height="100" as="geometry" />
        </mxCell>

      </root>
