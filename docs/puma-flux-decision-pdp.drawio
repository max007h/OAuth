<mxfile host="app.diagrams.net" modified="2026-09-22T12:00:00.000Z" agent="PUMA POC" version="24.0.0">
  <diagram id="puma-pdp-flow" name="Flux de decision PUMA">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="PUMA - Chaine de decision au clic Create user" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="800" height="30" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="Front PUMA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Backend PUMA - role PEP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="PingAuthorize - role PDP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="PingDirectory - role PIP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="820" y="60" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="PostgreSQL - role PIP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1080" y="60" width="220" height="40" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="&lt;b&gt;1. Clic Create user&lt;/b&gt;&lt;br&gt;POST /api/users&lt;br&gt;uid cible, assignments&lt;br&gt;(application, nodeId, role)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;2. Validation du token&lt;/b&gt;&lt;br&gt;sub donne managerUid&lt;br&gt;construction de la liste&lt;br&gt;des noeuds cibles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="&lt;b&gt;3. Appel du PDP&lt;/b&gt;&lt;br&gt;POST /governance-engine/batch&lt;br&gt;une decision par noeud cible&lt;br&gt;&lt;i&gt;uid, targetApplication, targetNode&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="310" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="Le PEP ne declare aucun droit.&lt;br&gt;Il ne decrit que la cible.&lt;br&gt;Plus de managerNodes,&lt;br&gt;plus de targetNodeParents." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=8;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="&lt;b&gt;4. Reception&lt;/b&gt;&lt;br&gt;domain PUMA&lt;br&gt;service PUMA.Administration&lt;br&gt;action assign" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="&lt;b&gt;5. Recherche LDAP&lt;/b&gt;&lt;br&gt;(uid=managerUid)&lt;br&gt;ou=People,dc=example,dc=com&lt;br&gt;rend les attributs partnerGrant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="490" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="&lt;b&gt;6. managerGrants&lt;/b&gt; (XPath)&lt;br&gt;BusinessApp1|9200005|ShopAdmin&lt;br&gt;BusinessApp1|9200002|ShopAdmin&lt;br&gt;BusinessApp2|9200005|ShopAdmin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="580" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="&lt;b&gt;7. grantsForApp&lt;/b&gt;&lt;br&gt;filtre sur le prefixe applicatif&lt;br&gt;BusinessApp2 ecarte&lt;br&gt;2 grants retenus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="670" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="&lt;b&gt;8. nodesFromGrants&lt;/b&gt;&lt;br&gt;segment noeud des grants retenus&lt;br&gt;9200005, 9200002&lt;br&gt;&lt;i&gt;la branche du manager&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="760" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n9" value="&lt;b&gt;9. targetNodeParentsDB&lt;/b&gt;&lt;br&gt;WITH RECURSIVE sur node_parent&lt;br&gt;ancetres de targetNode&lt;br&gt;9200005, 9100002, 9300001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="760" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n10" value="&lt;b&gt;10. matchedNodesDB&lt;/b&gt;&lt;br&gt;intersection des deux listes&lt;br&gt;resultat 9200005&lt;br&gt;matchCountDB = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="870" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="note10" value="&lt;b&gt;Le croisement, coeur de la regle&lt;/b&gt;&lt;br&gt;Le noeud cible est-il un descendant&lt;br&gt;d'un noeud sur lequel le manager&lt;br&gt;detient un grant pour cette application ?&lt;br&gt;Les deux axes sont testes sur la meme ligne&lt;br&gt;de grant, pas separement." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="870" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n11" value="&lt;b&gt;11. Rule node authorised&lt;/b&gt;&lt;br&gt;matchCountDB superieur a 0&lt;br&gt;effet Permit&lt;br&gt;policy DenyUnlessPermit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="970" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n12" value="&lt;b&gt;12. Application de la decision&lt;/b&gt;&lt;br&gt;PERMIT, ecriture en base&lt;br&gt;DENY, 403 et rien n'est cree&lt;br&gt;&lt;i&gt;le PEP ne reevalue rien&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="1060" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n13" value="&lt;b&gt;13. Retour utilisateur&lt;/b&gt;&lt;br&gt;confirmation ou refus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
