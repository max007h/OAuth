        <mxCell id="filtre" value="&lt;b&gt;Ce que lit le PDP&lt;/b&gt;&lt;br&gt;&lt;br&gt;baseDN : uid=thomas.martin,ou=People,dc=example,dc=com&lt;br&gt;scope : sub&lt;br&gt;filtre : (&amp;amp;(objectClass=pumaAssignment)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(pumaApplication=BusinessApp1))&lt;br&gt;&lt;br&gt;&lt;i&gt;Le filtre applicatif est fait par l'annuaire.&lt;br&gt;Plus de startsWith sur prefixe composite.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
